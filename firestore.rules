            incoming().diff(existing()).affectedKeys().hasOnly(['completed', 'completedAtMs', 'completedByUid', 'updatedAt']) ||
            // Creator or Admin can edit details
            ((existing().createdByUid == request.auth.uid || isFamilyAdmin(familyId)) &&
             incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'assignedToUid', 'assignedToName', 'priority', 'dueAtMs', 'completed', 'completedAtMs', 'completedByUid', 'updatedAt']))
          );
        allow delete: if isSignedIn() && isValidId(taskId) &&
          (existing().createdByUid == request.auth.uid || isFamilyAdmin(familyId));
      }

      // 3j. Family Expense Manager (BDT)
      match /expenses/{expenseId} {
        allow get: if isSignedIn() && isValidId(expenseId) && isFamilyMember(familyId);
        allow list: if isFamilyMember(familyId);
        allow create: if isSignedIn() && isValidId(expenseId) &&
          incoming().familyId == familyId &&
          incoming().createdByUid == request.auth.uid &&
          incoming().keys().hasAll(['familyId', 'title', 'category', 'amountBdt', 'paidByUid', 'paidByName', 'expenseDateMs', 'createdByUid', 'createdAt', 'updatedAt']) &&
          incoming().keys().hasOnly(['familyId', 'title', 'category', 'amountBdt', 'paidByUid', 'paidByName', 'expenseDateMs', 'notes', 'createdByUid', 'createdAt', 'updatedAt']) &&
          isValidFamilyExpense(incoming()) &&
          isValidTimestamp(incoming().createdAt) &&
          isValidTimestamp(incoming().updatedAt) &&
          isFamilyMember(familyId);
        allow update: if isSignedIn() && isValidId(expenseId) &&
          isValidFamilyExpense(incoming()) &&
          isFamilyMember(familyId) &&
          (existing().createdByUid == request.auth.uid || isFamilyAdmin(familyId)) &&
          incoming().familyId == existing().familyId &&
          incoming().createdByUid == existing().createdByUid &&
          incoming().createdAt == existing().createdAt &&
          isValidTimestamp(incoming().updatedAt) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'category', 'amountBdt', 'paidByUid', 'paidByName', 'expenseDateMs', 'notes', 'updatedAt']);
        allow delete: if isSignedIn() && isValidId(expenseId) &&
          (existing().createdByUid == request.auth.uid || isFamilyAdmin(familyId));
      }

      // 3k. Family Notice Board (Admin publishes; members acknowledge read)
      match /notices/{noticeId} {
        allow get: if isSignedIn() && isValidId(noticeId) && isFamilyMember(familyId);
        allow list: if isFamilyMember(familyId);
        allow create: if isFamilyAdmin(familyId) && isValidId(noticeId) &&
          incoming().familyId == familyId &&
          incoming().authorUid == request.auth.uid &&
          incoming().keys().hasAll(['familyId', 'title', 'body', 'pinned', 'readByUids', 'authorUid', 'authorName', 'createdAt', 'updatedAt']) &&
          incoming().keys().hasOnly(['familyId', 'title', 'body', 'pinned', 'expiresAtMs', 'readByUids', 'authorUid', 'authorName', 'createdAt', 'updatedAt']) &&
          isValidFamilyNotice(incoming()) &&
          isValidTimestamp(incoming().createdAt) &&
          isValidTimestamp(incoming().updatedAt);
        allow update: if isSignedIn() && isValidId(noticeId) &&
          isValidFamilyNotice(incoming()) &&
          isFamilyMember(familyId) &&
          incoming().familyId == existing().familyId &&
          incoming().authorUid == existing().authorUid &&
          incoming().createdAt == existing().createdAt &&
          isValidTimestamp(incoming().updatedAt) && (
            (isFamilyAdmin(familyId) &&
             incoming().diff(existing()).affectedKeys().hasOnly(['title', 'body', 'pinned', 'expiresAtMs', 'readByUids', 'updatedAt'])) ||
            (request.auth.uid in incoming().readByUids &&
             incoming().readByUids.hasAll(existing().readByUids) &&
             incoming().diff(existing()).affectedKeys().hasOnly(['readByUids', 'updatedAt']))
          );
        allow delete: if isFamilyAdmin(familyId) && isValidId(noticeId);
      }

      // 3l. Secure Family File Vault
      match /vault_files/{fileId} {
        allow get: if isSignedIn() && isValidId(fileId) &&
          (request.auth.uid in existing().allowedUids || isFamilyAdmin(familyId));
        allow list: if isSignedIn() &&
          (request.auth.uid in existing().allowedUids || isFamilyAdmin(familyId));
        allow create: if isSignedIn() && isValidId(fileId) &&
          incoming().familyId == familyId &&
          incoming().uploadedByUid == request.auth.uid &&
          request.auth.uid in incoming().allowedUids &&
          incoming().keys().hasAll(['familyId', 'title', 'folder', 'fileName', 'mimeType', 'fileSizeBytes', 'fileBase64', 'uploadedByUid', 'uploadedByName', 'allowedUids', 'createdAt', 'updatedAt']) &&
          incoming().keys().hasOnly(['familyId', 'title', 'folder', 'fileName', 'mimeType', 'fileSizeBytes', 'fileBase64', 'uploadedByUid', 'uploadedByName', 'allowedUids', 'createdAt', 'updatedAt']) &&
          isValidVaultFile(incoming()) &&
          isValidTimestamp(incoming().createdAt) &&
          isValidTimestamp(incoming().updatedAt) &&
          isFamilyMember(familyId);
        allow update: if isSignedIn() && isValidId(fileId) &&
          isValidVaultFile(incoming()) &&
          (existing().uploadedByUid == request.auth.uid || isFamilyAdmin(familyId)) &&
          incoming().familyId == existing().familyId &&
          incoming().uploadedByUid == existing().uploadedByUid &&
          incoming().createdAt == existing().createdAt &&
          isValidTimestamp(incoming().updatedAt) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'folder', 'allowedUids', 'updatedAt']);
        allow delete: if isSignedIn() && isValidId(fileId) &&
          (existing().uploadedByUid == request.auth.uid || isFamilyAdmin(familyId));
      }
    }
  }
}
